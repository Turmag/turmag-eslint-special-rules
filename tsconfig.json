{
    "compilerOptions": {
        "allowSyntheticDefaultImports": true,
        "baseUrl": ".",
        "lib": ["esnext", "dom"],
        "module": "esnext",
        "moduleResolution": "node",
        "paths": { 
            "@tests/*": ["./tests/lib/rules/*"],
            "@rules/*": ["./lib/rules/*"]
        },
        "outDir": "./dist",
        "declaration": true,
        "strict": true,
        "target": "esnext"
    },
    "parserOptions": {
        "sourceType": "module",
    },
    "include": [
        "**/rules/*.ts"
    ],
    "exclude": ["node_modules", "tests"]
}
